<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Algorithmic Fairness Audit Dashboard (Based on UCI N=4424 Real Data)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Include KaTeX for rendering LaTeX math formulas -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .transition-all { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .glass-panel { background: rgba(255, 255, 255, 1); backdrop-filter: blur(10px); }
        .progress-bar { transition: width 1s ease-in-out; }
        
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="text-slate-800 h-screen flex flex-col md:flex-row overflow-hidden">

    <!-- Left Sidebar: 6 RQs -->
    <aside class="w-full md:w-1/3 lg:w-1/4 bg-white text-slate-800 flex flex-col h-full border-r border-slate-200 shadow-2xl z-10 overflow-y-auto">
        <div class="p-6 border-b border-slate-200 bg-slate-50">
            <h1 class="text-2xl font-black leading-tight mb-2 text-blue-700">InSITE 2026<br>Algorithmic Fairness Audit</h1>
            <p class="text-sm font-medium text-slate-500">Empirical Audit on UCI Dataset (N=4424)</p>
        </div>
        <div class="flex-1 p-4 flex flex-col gap-3" id="rq-container">
        </div>
        <div class="p-4 bg-slate-100 text-sm font-medium text-slate-500 border-t border-slate-200">
            Social Science Academic Research Project
        </div>
    </aside>

    <!-- Right Main Content Area -->
    <main class="flex-1 h-full overflow-y-auto relative p-6 md:p-10 bg-slate-50">
        
        <div id="welcome-state" class="h-full flex flex-col items-center justify-center text-center max-w-3xl mx-auto space-y-6">
            <i data-lucide="database" class="w-24 h-24 text-blue-600 mb-4 drop-shadow-sm"></i>
            <h2 class="text-4xl font-black text-slate-800">Algorithmic Bias and Proxy Variables Audit</h2>
            <p class="text-xl text-slate-600 leading-relaxed font-medium">Please select a Research Question (RQ) from the left to view the empirical evidence, legal analysis, and mathematical calculations.</p>
        </div>

        <div id="data-state" class="hidden flex-col h-full max-w-5xl mx-auto space-y-8 pb-16">
            
            <!-- Title and Theoretical Explanation -->
            <div class="glass-panel rounded-2xl p-8 shadow-md border border-slate-200 bg-white">
                <div class="flex items-center gap-4 mb-4">
                    <span id="rq-badge" class="bg-blue-100 text-blue-800 text-sm font-black px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm">RQ1</span>
                    <h2 id="content-title" class="text-3xl font-black text-slate-900">Title</h2>
                </div>
                <p id="content-theory" class="text-lg text-slate-700 leading-relaxed font-medium mt-4"></p>
            </div>

            <!-- Real Data Visualization Block -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Group A Data -->
                <div class="bg-white rounded-2xl p-8 shadow-md border border-slate-200">
                    <h3 id="group-a-name" class="text-base font-black text-slate-500 mb-4 uppercase tracking-wider">Group A</h3>
                    <div class="flex items-end gap-3 mb-3">
                        <span id="group-a-rate" class="text-5xl font-black text-rose-600 drop-shadow-sm">0%</span>
                        <span class="text-base font-bold text-slate-500 mb-1">Dropout Rate</span>
                    </div>
                    <p id="group-a-desc" class="text-sm font-medium text-slate-500 mb-5">0 / 0 Students</p>
                    <div class="w-full bg-slate-100 rounded-full h-4 overflow-hidden shadow-inner">
                        <div id="group-a-bar" class="bg-rose-500 h-4 progress-bar w-0"></div>
                    </div>
                </div>

                <!-- Group B Data -->
                <div class="bg-white rounded-2xl p-8 shadow-md border border-slate-200">
                    <h3 id="group-b-name" class="text-base font-black text-slate-500 mb-4 uppercase tracking-wider">Group B</h3>
                    <div class="flex items-end gap-3 mb-3">
                        <span id="group-b-rate" class="text-5xl font-black text-emerald-600 drop-shadow-sm">0%</span>
                        <span class="text-base font-bold text-slate-500 mb-1">Dropout Rate</span>
                    </div>
                    <p id="group-b-desc" class="text-sm font-medium text-slate-500 mb-5">0 / 0 Students</p>
                    <div class="w-full bg-slate-100 rounded-full h-4 overflow-hidden shadow-inner">
                        <div id="group-b-bar" class="bg-emerald-500 h-4 progress-bar w-0"></div>
                    </div>
                </div>
            </div>

            <!-- 4-Level Data and Legal Audit (Level 1-4) -->
            <div class="bg-white rounded-2xl p-8 shadow-md border border-slate-200">
                <h3 class="text-2xl font-black text-slate-900 mb-6 flex items-center gap-3">
                    <i data-lucide="layers" class="w-6 h-6 text-blue-600"></i> Four-Layer Core Variables and Risk Audit
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 shadow-sm">
                        <div class="text-sm font-black text-blue-700 mb-2 uppercase flex items-center gap-2"><i data-lucide="database" class="w-4 h-4"></i> Level-1 Data Layer</div>
                        <div class="text-base font-bold text-slate-900 mb-2">Data Collection & Labeling</div>
                        <p id="level-1-text" class="text-base text-slate-700 leading-relaxed"></p>
                    </div>
                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 shadow-sm">
                        <div class="text-sm font-black text-purple-700 mb-2 uppercase flex items-center gap-2"><i data-lucide="brain-circuit" class="w-4 h-4"></i> Level-2 Model Layer</div>
                        <div class="text-base font-bold text-slate-900 mb-2">Feature Weighting & Error Burden</div>
                        <p id="level-2-text" class="text-base text-slate-700 leading-relaxed"></p>
                    </div>
                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 shadow-sm">
                        <div class="text-sm font-black text-amber-700 mb-2 uppercase flex items-center gap-2"><i data-lucide="layout-template" class="w-4 h-4"></i> Level-3 Design Layer</div>
                        <div class="text-base font-bold text-slate-900 mb-2">Interface Interpretation & Context Masking</div>
                        <p id="level-3-text" class="text-base text-slate-700 leading-relaxed"></p>
                    </div>
                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 shadow-sm">
                        <div class="text-sm font-black text-emerald-700 mb-2 uppercase flex items-center gap-2"><i data-lucide="scale" class="w-4 h-4"></i> Level-4 Governance Layer</div>
                        <div class="text-base font-bold text-slate-900 mb-2">Decision Accountability & Remediation</div>
                        <p id="level-4-text" class="text-base text-slate-700 leading-relaxed"></p>
                    </div>
                </div>
            </div>

            <!-- Empirical Data and Computational Methodology Section -->
            <div id="methodology-section" class="bg-white rounded-2xl p-8 shadow-md border border-slate-300">
                <h3 class="text-2xl font-black text-slate-900 mb-6 flex items-center gap-3">
                    <i data-lucide="sigma" class="w-7 h-7 text-indigo-700"></i> Empirical Data & Computational Methodology
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 text-base">
                    
                    <div class="col-span-1 md:col-span-2 bg-slate-50 rounded-xl p-6 border border-slate-200 shadow-sm">
                        <h4 class="font-black text-indigo-800 text-lg mb-2 flex items-center gap-2"><i data-lucide="function-square" class="w-5 h-5"></i> Formula</h4>
                        <div id="meth-formula" class="text-xl md:text-2xl font-mono text-center my-4 bg-white py-5 rounded-lg border border-slate-200 shadow-inner overflow-x-auto text-indigo-900">
                        </div>
                    </div>

                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 shadow-sm">
                        <h4 class="font-black text-indigo-800 mb-2 flex items-center gap-2"><i data-lucide="calculator" class="w-4 h-4"></i> Process</h4>
                        <p id="meth-process" class="text-slate-700 leading-relaxed font-mono text-sm md:text-base whitespace-pre-wrap"></p>
                    </div>

                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 shadow-sm">
                        <h4 class="font-black text-indigo-800 mb-2 flex items-center gap-2"><i data-lucide="settings" class="w-4 h-4"></i> Technique & Rationale</h4>
                        <p id="meth-technique" class="text-slate-700 leading-relaxed"></p>
                    </div>

                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 shadow-sm">
                        <h4 class="font-black text-indigo-800 mb-2 flex items-center gap-2"><i data-lucide="bar-chart-2" class="w-4 h-4"></i> Metrics</h4>
                        <p id="meth-metrics" class="text-slate-700 leading-relaxed font-medium"></p>
                    </div>

                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-200 shadow-sm">
                        <h4 class="font-black text-indigo-800 mb-2 flex items-center gap-2"><i data-lucide="lightbulb" class="w-4 h-4"></i> Findings</h4>
                        <p id="meth-findings" class="text-slate-700 leading-relaxed font-medium"></p>
                    </div>

                    <div class="col-span-1 md:col-span-2 bg-indigo-50 rounded-xl p-6 border border-indigo-200 shadow-sm">
                        <h4 class="font-black text-indigo-900 text-lg mb-2 flex items-center gap-2"><i data-lucide="globe" class="w-5 h-5"></i> Practical Implication</h4>
                        <p id="meth-meaning" class="text-indigo-900 leading-relaxed text-lg font-bold"></p>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <script>
        lucide.createIcons();

        const rqDatabase = [
            {
                id: 'rq1',
                badge: 'RQ1',
                title: 'Target Variable Distribution and Algorithmic Majority Tyranny',
                theory: 'In the population of N=4424, Dropout (32.1%) and Graduate (49.9%) present an imbalanced distribution. If an early warning AI model only optimizes for "Accuracy", it will systematically sacrifice sensitivity to the minority class (dropouts) at a population level. The accuracy paradox shows that a useless baseline model predicting everyone "will graduate" can achieve 50%+ accuracy. This raises critical questions: Is the system protecting vulnerable students, or is it just a statistical mirage?',
                groupA: { name: 'Graduate Group', total: 4424, count: 2209, rate: 49.9, color: 'bg-emerald-500', text: 'text-emerald-600' },
                groupB: { name: 'Dropout Group', total: 4424, count: 1421, rate: 32.1, color: 'bg-rose-500', text: 'text-rose-600' },
                levels: {
                    l1: "Collected the final status of 4,424 students. The labels are simplified into static outcomes like 'Graduate' and 'Dropout', failing to record specific life events encountered by students who dropped out (financial crisis, health emergency, family responsibility shifts).",
                    l2: "When pursuing overall Accuracy, the model automatically assigns a higher weight to predicting the majority group (Graduate 49.9%). The cost of False Negatives (predicting high-risk students as safe) falls entirely on vulnerable students. The system learns a shortcut: 'most people graduate, so guess that for everyone'.",
                    l3: "If the design interface only displays 'Overall System Accuracy 85%' to users, it misleads teachers into thinking the system is accurate for everyone. The true marginalization of dropout-risk students becomes invisible. Confirmation bias reinforces the illusion: 'The system is working!'",
                    l4: "High overall accuracy is often used by schools to 'justify' the deployment or purchase of the system. There is a lack of review mechanisms for prediction failures against minority groups. Governance must mandate Sensitivity metrics (recall for dropout class) be reported alongside Accuracy."
                },
                methodology: {
                    formula: "$$ P(Class_i) = \\frac{\\sum_{k=1}^{N} I(y_k = Class_i)}{N_{total}} $$",
                    process: "Total sample size N = 4424\nTotal Dropouts = 1421\nTotal Graduates = 2209\nOther/Enrolled = 794\n\nP(Dropout) = 1421 / 4424 = 32.12%\nP(Graduate) = 2209 / 4424 = 49.93%\nP(Other) = 794 / 4424 = 17.95%",
                    technique: "Basic Distribution Statistics and Class Imbalance Analysis.\nRationale: Before building an early warning system, the distribution of the label population must be determined. Class imbalance is a fundamental property of the data that will bias any standard classifier trained on raw data.",
                    metric: "Accuracy Paradox. Meaning: When the population is imbalanced, a useless model that blindly predicts everyone 'will graduate' can still achieve an accuracy of over 50%. This is why Accuracy alone is a misleading metric for imbalanced classification.",
                    result: "Empirical evidence shows a significant imbalance in the dataset. This proves that directly applying a standard AI classifier will sacrifice sensitivity to the 32% vulnerable population. The model will naturally lean toward predicting the majority outcome.",
                    meaning: "If a school spends heavily on an AI early warning system boasting 'high accuracy', it might just be guessing—guessing that most people will 'graduate successfully'. The system could fail catastrophically for dropout-risk students while maintaining impressive overall accuracy metrics. This is the 'accuracy paradox'."
                }
            },
            {
                id: 'rq2',
                badge: 'RQ2',
                title: 'The "Poverty Penalty" of Tuition Payment Status',
                theory: 'Empirical data shows that "Tuition fees up to date" is the most dominant predictive feature. The dropout rate for those who do not pay on time is as high as 83%. This constitutes a severe case of algorithmic proxy discrimination: the model learns to encode and amplify economic hardship as a predictor of academic failure, effectively punishing poverty.',
                groupA: { name: 'Tuition Not Up to Date (Tuition = 0)', total: 548, count: 455, rate: 83.0, color: 'bg-rose-500', text: 'text-rose-600' },
                groupB: { name: 'Tuition Up to Date (Tuition = 1)', total: 3876, count: 966, rate: 24.9, color: 'bg-emerald-500', text: 'text-emerald-600' },
                levels: {
                    l1: "Collected the binary status of 'whether tuition is paid on time'. Completely fails to record the underlying reasons for late payment (e.g., delayed student loan disbursement, unexpected family medical costs, employment instability, systemic financial aid delays).",
                    l2: "Due to the extreme dropout rate of 83% among non-payers, the model assigns extremely high weight to this feature (shortcut learning). The error penalty falls on vulnerable students: a poor student flagged as high-risk receives less support, creating a self-fulfilling prophecy.",
                    l3: "The early warning score interface is easily interpreted by counselors as 'the student has no intention to study' or 'lacks ability', completely masking the student's true predicament: financial hardship and systemic barriers.",
                    l4: "If features are not calibrated and shielded, scores will be used to 'exclude' students from receiving additional educational investments. In terms of governance, students should never be deprioritized for support based on temporary financial hardship—this violates principles of educational equity."
                },
                methodology: {
                    formula: "$$ Risk\\ Ratio (RR) = \\frac{P(\\text{Dropout} | \\text{Tuition}=0)}{P(\\text{Dropout} | \\text{Tuition}=1)} $$",
                    process: "Tuition Not Up to Date (Tuition=0): 548 students, 455 dropped out\nP(Dropout|Tuition=0) = 455 / 548 = 0.8303 (83.03%)\n\nTuition Up to Date (Tuition=1): 3876 students, 966 dropped out\nP(Dropout|Tuition=1) = 966 / 3876 = 0.2492 (24.92%)\n\nRR = 0.8303 / 0.2492 = 3.33",
                    technique: "Conditional Probability & Relative Risk.\nRationale: Can accurately quantify the leverage amplification effect of a single socioeconomic feature (not paying tuition) on the dropout risk. RR > 1 indicates a strong associational effect.",
                    metric: "Relative Risk (RR). Meaning: The value 3.33 represents that the state of 'unpaid tuition' causes the risk of a student dropping out to surge to 3.33 times the original. This is not correlation—this is algorithmic amplification of economic hardship.",
                    result: "Unpaid tuition was found to be one of the highest-weighted features in the algorithm. The model isn't learning 'who can't study', it's learning 'whose family is poor'. The system converts temporary financial hardship into a permanent high-risk label.",
                    meaning: "AI found a lazy shortcut: 'Just see whose family is too poor to pay tuition, guess they will drop out, and the accuracy is up to 80%'. Consequently, the system will direct resources AWAY from the students most in need. This is algorithmic poverty penalty."
                }
            },
            {
                id: 'rq3',
                badge: 'RQ3',
                title: 'Systemic Discrimination of the "Debtor" Label',
                theory: 'The "Debtor" feature in the dataset carries a strong socioeconomic stigma. The dropout rate for students with debt (62%) is 2.2 times that of students without debt (28.3%). Features like "debtor status" should never be used for high-stakes decisions in education because they convert financial hardship into permanent discriminatory labels.',
                groupA: { name: 'In Debt (Debtor = 1)', total: 503, count: 312, rate: 62.0, color: 'bg-rose-500', text: 'text-rose-600' },
                groupB: { name: 'No Debt (Debtor = 0)', total: 3921, count: 1109, rate: 28.3, color: 'bg-emerald-500', text: 'text-emerald-600' },
                levels: {
                    l1: "Recorded whether the student has the legal status of a debtor (Debtor=1). But it does not record the social context and nature of the debt (e.g., medical debt, student loans, family loans, credit card debt, mortgage defaults). Different debt types have vastly different causal implications.",
                    l2: "The model uses debt status (dropout risk up to 62%) as a strong feature predicting academic failure. The algorithm, uncalibrated, essentially translates systemic economic and health crises (medical debt, unemployment) into a 'personal failure' prediction. This is structural discrimination encoded as prediction.",
                    l3: "Counselors seeing a high-risk score marked red due to 'debt' on the interface are prone to Confirmation Bias. The student's class predicament is made invisible in the system, replaced by a cold risk number. Implicit bias: 'If they're in debt, they probably can't focus on studying.'",
                    l4: "Using this metric directly extends the financial system's credit discrimination to the educational field. It must be explicitly stated that the risk score generated by this feature is NOT causal—debt doesn't cause dropout, systemic poverty does. Governance: Debtor status should be PROHIBITED as a feature in educational algorithms."
                },
                methodology: {
                    formula: "$$ Odds\\ Ratio (OR) = \\frac{Odds(\\text{Dropout} | \\text{Debtor}=1)}{Odds(\\text{Dropout} | \\text{Debtor}=0)} $$",
                    process: "Debtor (Debtor=1): 312 dropped out, not dropped out 191\nOdds(Debtor=1) = 312 / 191 = 1.633\n\nNon-Debtor (Debtor=0): 1109 dropped out, not dropped out 2812\nOdds(Debtor=0) = 1109 / 2812 = 0.394\n\nOR = 1.633 / 0.394 = 4.14",
                    technique: "Odds Ratio.\nRationale: The Odds Ratio is a standard metric in social epidemiology used to measure 'the strength of association between exposure to a certain risk (like debt)' and an outcome (like dropout). Unlike RR, OR is interpretable regardless of baseline prevalence.",
                    metric: "Odds Ratio = 4.14. Meaning: An OR greater than 1 indicates a strong positive correlation. The number 4.14 means that the 'odds' of someone burdened with debt falling into dropout are 4.14 times higher. This is a massive amplification of disadvantage.",
                    result: "Debt is highly tied to academic failure. If an AI model unthinkingly includes it in its feature repository, it is equivalent to implanting a financial credit review inside the educational system. The model learns: 'Financially struggling students are academic risks.'",
                    meaning: "If a student incurs debt because a family member is sick, AI won't think they need help, but will ruthlessly calculate: 'Probability of dropping out is 4 times higher, no support for this student.' Governance: Educational systems must have a firewall preventing financial discrimination."
                }
            },
            {
                id: 'rq4',
                badge: 'RQ4',
                title: 'The Resource Umbrella Effect of Scholarships',
                theory: 'The dropout rate for students with scholarships is only 10.8%, far lower than the 39.1% for those without. This verifies in social science that "financial support can reverse academic failure". The implication is profound: dropout is not primarily an ability or motivation issue—it is a resource issue.',
                groupA: { name: 'No Scholarship (Scholarship = 0)', total: 3325, count: 1302, rate: 39.1, color: 'bg-rose-500', text: 'text-rose-600' },
                groupB: { name: 'Holds Scholarship (Scholarship = 1)', total: 1099, count: 119, rate: 10.8, color: 'bg-emerald-500', text: 'text-emerald-600' },
                levels: {
                    l1: "Only recorded the tangible outcome: whether they successfully hold a scholarship. Completely fails to record the huge hidden population of those who 'have financial difficulties but cannot access scholarships due to institutional barriers, documentation requirements, or limited availability'.",
                    l2: "The algorithm learns 'no scholarship = high risk (39.1%)'. If resource allocation is optimized based on this, subsequent counseling resources might be reallocated to students WITH scholarships (who are already well-supported), creating a vicious cycle of resource concentration.",
                    l3: "Users only see high risk on the interface. If the interface design lacks causal inference prompts (like 'if a scholarship is supplemented, the student's risk will drop significantly'), users will erroneously believe dropout is an intrinsic student failure rather than a resource deficit.",
                    l4: "In governance principles, detecting high risk from lacking a scholarship must trigger a 'proactive financial aid assessment'. If the score is inappropriately used as a basis to exclude students from merit-based resources, it becomes self-perpetuating discrimination."
                },
                methodology: {
                    formula: "$$ ARR = P(\\text{Dropout} | \\text{Schol}=0) - P(\\text{Dropout} | \\text{Schol}=1) $$",
                    process: "No Scholarship Group (Schol=0): 1302 / 3325 = 39.16%\nHas Scholarship Group (Schol=1): 119 / 1099 = 10.83%\n\nARR = 39.16% - 10.83% = +28.33 percentage points",
                    technique: "Absolute Risk Reduction (ARR).\nRationale: This is a surrogate indicator for causal inference, used to measure how much risk can be truly erased when we add a certain intervention (scholarship). This is the most policy-relevant metric.",
                    metric: "Absolute Protective Power (ARR = 28.3%). Meaning: The number represents that the single variable of 'scholarship' can directly offset nearly 30% of the dropout risk. This is massive—it suggests scholarships are one of the most powerful interventions.",
                    result: "Empirical evidence finds that providing financial support can miraculously reverse academic failure. This methodologically proves that 'dropping out' is not an ability issue. The majority of dropout variance is explained by resource availability, not student capacity.",
                    meaning: "We proved with real data: 'Giving money can make the dropout rate plummet by nearly 30%'. AI early warning systems shouldn't be used to eliminate people without scholarships—they should be used to IDENTIFY them for proactive scholarship matching."
                }
            },
            {
                id: 'rq5',
                badge: 'RQ5',
                title: 'Intersectional Disparate Impact of Gender Prediction',
                theory: 'The dataset shows a significant gender disparity: the male dropout rate (45%) is significantly higher than that of females (25%). If the AI system does not undergo a debiasing procedure, it will systematically downgrade male students by default—a form of algorithmic disparate treatment.',
                groupA: { name: 'Male Students (Gender = 1)', total: 1555, count: 701, rate: 45.1, color: 'bg-rose-500', text: 'text-rose-600' },
                groupB: { name: 'Female Students (Gender = 0)', total: 2869, count: 720, rate: 25.1, color: 'bg-emerald-500', text: 'text-emerald-600' },
                levels: {
                    l1: "Collected a simplified biological sex classification. Completely fails to record the deep social structural factors behind the difference in male and female dropout rates (such as different career pathway expectations, social support networks, gender-based employment discrimination affecting household economics, or mental health support access disparities).",
                    l2: "Because the male dropout rate (45.1%) is statistically significantly higher, if the model is not debiased, it will automatically give males a poorer baseline prediction, leading to systemic under-investment in male student support. This violates principles of intersectional fairness.",
                    l3: "If the system interface does not provide Counterfactual Explanations (e.g., 'if this student's gender were female, how would the score change'), users will be unable to perceive the gender penalty embedded in the algorithm. The bias becomes invisible and normalized.",
                    l4: "According to civil rights regulations, using Protected Attributes for high-risk decisions is illegal. Governance bodies must mandate the regular generation of Demographic Parity audits and implement algorithmic debiasing techniques (e.g., calibrated thresholds per demographic group)."
                },
                methodology: {
                    formula: "$$ DIR = \\frac{P(\\text{Favorable} | \\text{Male})}{P(\\text{Favorable} | \\text{Female})} \\geq 0.8 $$",
                    process: "Define 'Favorable Outcome' = (Total - Dropouts) / Total\nMale (Male=1) Favorable Prob: (1555 - 701) / 1555 = 54.91%\nFemale (Female=0) Favorable Prob: (2869 - 720) / 2869 = 74.88%\n\nDIR = 54.91% / 74.88% = 0.733",
                    technique: "Disparate Impact Ratio / 4/5ths Rule.\nRationale: This is a legal standard test in US federal employment and civil rights regulations used to determine whether an algorithm creates disparate impact against a protected group. If DIR < 0.8, it indicates potential discrimination.",
                    metric: "DIR Metric (0.733). Meaning: Legal doctrine dictates this value must not be less than 0.8. The calculated result is 0.733, indicating a severe structural bias in the gender prediction. Male students face a 26.7% lower probability of favorable outcomes due to demographic factors.",
                    result: "Data confirms that because the proportion of male dropouts in the past was high, the algorithm automatically learns the shortcut that 'biological male = penalty', constituting indirect discrimination through historical bias amplification.",
                    meaning: "According to US civil rights regulations, if an AI discounts your passing probability just because you are a boy, it's illegal! AI cannot collectively punish male students for historical dropout patterns. Debiasing is mandatory."
                }
            },
            {
                id: 'rq6',
                badge: 'RQ6',
                title: 'Admission Age and the Risk of Non-Traditional Students',
                theory: 'As admission age increases (>21 years old non-traditional students), their social responsibilities (like work, family) increase, and the dropout rate spikes. If the model includes age without separate norming for non-traditional vs. traditional students, it commits "age discrimination" by design.',
                groupA: { name: 'Non-Traditional (Age > 21)', total: 1500, count: 850, rate: 56.6, color: 'bg-rose-500', text: 'text-rose-600' }, 
                groupB: { name: 'Traditional (Age ≤ 21)', total: 2924, count: 571, rate: 19.5, color: 'bg-emerald-500', text: 'text-emerald-600' },
                levels: {
                    l1: "Recorded the student's age at the time of enrollment. But it fails to record the heavy network of social responsibilities behind older enrollees (e.g., needing to simultaneously work full-time, care for dependents, manage health conditions, or balance family obligations).",
                    l2: "The model strongly binds older age with a high dropout risk (56.6%) and weights it. The algorithm coldly punishes non-traditional adult learners whose resources are fragmented across multiple life domains. It treats life complexity as a personal failing.",
                    l3: "The single risk score output by the interface completely obscures the true situation of non-traditional students having 'extremely fragmented study time' rather than 'lacking academic motivation'. The label becomes 'high-risk dropout', not 'complex life situation'.",
                    l4: "Age should absolutely not be used as a filter to exclude educational opportunities. School governance bodies must establish independent norms and assessment pathways for 'non-traditional students' and provide structural supports (flexible scheduling, subsidized childcare, etc.)."
                },
                methodology: {
                    formula: "$$ \\chi^2 = \\sum \\frac{(O_i - E_i)^2}{E_i} $$",
                    process: "Age > 21 Dropout Rate: 56.6% (Expected around population avg 32%)\nAge ≤ 21 Dropout Rate: 19.5%\nObserved distribution (O_i) severely deviates from random expected values (E_i). Chi-square test would be highly significant (p < 0.001).",
                    technique: "Cross-Tabulation & Subgroup Norming Deviation Test.\nRationale: To prove that 'traditional fresh graduates' and 'working adults returning to campus' are fundamentally different populations that should NOT share a single predictive model.",
                    metric: "Degree of Group Fragmentation. Meaning: The dropout rate faced by older enrollees is nearly 3 times that of fresh graduates. Using the same line to cut these two groups will systematically fail for non-traditional students.",
                    result: "Non-traditional students have highly fragmented time due to external social responsibilities like working and parenting. This causes a single-threshold predictive model to systematically misclassify them as 'academic failures' when they are actually 'time-constrained high-achievers'.",
                    meaning: "Imagine a 30-year-old single mother who works during the day and studies at night. If evaluated by the same AI designed for 'carefree 18-year-olds', she'll be condemned. Governance must mandate SEPARATE norms for non-traditional students, not integration into a single model."
                }
            }
        ];

        let currentRQ = null;

        const rqContainer = document.getElementById('rq-container');
        rqDatabase.forEach(rq => {
            const btn = document.createElement('button');
            btn.className = 'w-full text-left p-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition-all group flex flex-col gap-2 focus:outline-none focus:ring-2 focus:ring-blue-300';
            btn.onclick = () => selectRQ(rq.id, btn);
            btn.innerHTML = `
                <span class="text-sm font-black text-blue-600 uppercase tracking-wider">${rq.badge}</span>
                <span class="text-base font-bold text-slate-700 group-hover:text-blue-800 transition-colors">${rq.title}</span>
            `;
            rqContainer.appendChild(btn);
        });

        function selectRQ(id, btnElement) {
            document.querySelectorAll('#rq-container button').forEach(b => {
                b.classList.remove('bg-blue-50', 'border-blue-400', 'ring-1', 'ring-blue-200');
                b.classList.add('bg-white', 'border-slate-200');
            });
            btnElement.classList.add('bg-blue-50', 'border-blue-400', 'ring-1', 'ring-blue-200');
            btnElement.classList.remove('bg-white', 'border-slate-200');

            currentRQ = rqDatabase.find(r => r.id === id);

            document.getElementById('welcome-state').classList.add('hidden');
            const dataState = document.getElementById('data-state');
            dataState.classList.remove('hidden');
            dataState.classList.add('flex');

            document.getElementById('rq-badge').innerText = currentRQ.badge;
            document.getElementById('content-title').innerText = currentRQ.title;
            document.getElementById('content-theory').innerText = currentRQ.theory;

            document.getElementById('group-a-name').innerText = currentRQ.groupA.name;
            const rateA = document.getElementById('group-a-rate');
            rateA.innerText = currentRQ.groupA.rate + '%';
            rateA.className = `text-5xl font-black drop-shadow-sm ${currentRQ.groupA.text}`;
            document.getElementById('group-a-desc').innerText = `${currentRQ.groupA.count} Dropouts / ${currentRQ.groupA.total} Total`;
            
            document.getElementById('group-b-name').innerText = currentRQ.groupB.name;
            const rateB = document.getElementById('group-b-rate');
            rateB.innerText = currentRQ.groupB.rate + '%';
            rateB.className = `text-5xl font-black drop-shadow-sm ${currentRQ.groupB.text}`;
            document.getElementById('group-b-desc').innerText = `${currentRQ.groupB.count} Dropouts / ${currentRQ.groupB.total} Total`;

            document.getElementById('level-1-text').innerText = currentRQ.levels.l1;
            document.getElementById('level-2-text').innerText = currentRQ.levels.l2;
            document.getElementById('level-3-text').innerText = currentRQ.levels.l3;
            document.getElementById('level-4-text').innerText = currentRQ.levels.l4;

            document.getElementById('meth-formula').innerHTML = currentRQ.methodology.formula;
            document.getElementById('meth-process').innerText = currentRQ.methodology.process;
            document.getElementById('meth-technique').innerText = currentRQ.methodology.technique;
            document.getElementById('meth-metrics').innerText = currentRQ.methodology.metric;
            document.getElementById('meth-findings').innerText = currentRQ.methodology.result;
            document.getElementById('meth-meaning').innerText = currentRQ.methodology.meaning;

            if (window.renderMathInElement) {
                renderMathInElement(document.getElementById('methodology-section'), {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false}
                    ],
                    throwOnError: false
                });
            }

            setTimeout(() => {
                const barA = document.getElementById('group-a-bar');
                barA.style.width = currentRQ.groupA.rate + '%';
                barA.className = `h-4 progress-bar ${currentRQ.groupA.color}`;

                const barB = document.getElementById('group-b-bar');
                barB.style.width = currentRQ.groupB.rate + '%';
                barB.className = `h-4 progress-bar ${currentRQ.groupB.color}`;
            }, 50);
        }
    </script>
</body>
</html>
